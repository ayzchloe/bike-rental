```gitignore
# Compiled and build artifacts
*.pyc
__pycache__/
*.o
*.obj
*.class
*.exe
*.dll
*.so
*.a
*.out

# Dependencies
node_modules/
venv/
.venv/
.env
.env.local
.env.*

# Build directories
dist/
build/
target/
*.log
*.tmp
*.swp

# Editors
.vscode/
.idea/

# Coverage reports
coverage/
htmlcov/
.coverage

# Cache directories
.mypy_cache/
.pytest_cache/
.gradle/
```